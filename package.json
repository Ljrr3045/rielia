{
  "name": "rielia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "12.15.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm --filter @rielia/contracts build && pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "smoke": "node scripts/smoke.mjs",
    "test:smoke": "node --test scripts/smoke-process.test.mjs",
    "test:identity": "pnpm --filter @rielia/contracts build && pnpm --filter @rielia/api build && node scripts/test-identity.mjs",
    "test:identity:logic": "node --test scripts/identity-logic.test.mjs scripts/identity-client.test.mjs",
    "test:workspaces:logic": "pnpm --filter @rielia/contracts build && node --test scripts/workspace-logic.test.mjs scripts/workspace-client.test.mjs",
    "test:projects:logic": "pnpm --filter @rielia/contracts build && node --test scripts/project-task-logic.test.mjs scripts/project-task-client.test.mjs scripts/task-events-client.test.mjs",
    "test:prototype": "node --test scripts/task-prototype.test.mjs",
    "test:mcp": "pnpm --filter @rielia/contracts build && pnpm --filter @rielia/api build && pnpm --filter @rielia/mcp-local build && pnpm --filter @rielia/mcp-local test",
    "test:runtime": "node scripts/test-runtime.mjs",
    "check:backend-closure": "node scripts/assert-backend-closure.mjs apps/api",
    "check": "pnpm format:check && pnpm test:quality && pnpm lint && pnpm check:backend-closure && pnpm test:smoke && pnpm test:identity:logic && pnpm test:workspaces:logic && pnpm test:projects:logic && pnpm test:prototype && pnpm test:web:integration && pnpm typecheck && pnpm build && pnpm --filter @rielia/mcp-local test && pnpm smoke",
    "dev:web": "pnpm --filter @rielia/contracts build && pnpm --filter @rielia/web dev",
    "dev:api": "pnpm --filter @rielia/contracts build && pnpm --filter @rielia/api dev",
    "prepare": "node .husky/install.mjs",
    "format:check": "node scripts/quality/format.mjs --check",
    "format:write": "node scripts/quality/format.mjs --write",
    "quality:staged": "node scripts/quality/staged.mjs",
    "quality:ci": "node scripts/quality/ci.mjs",
    "commit:check": "node scripts/quality/commits.mjs --stdin",
    "test:quality": "node --test scripts/quality/quality.test.mjs",
    "unit:api": "node scripts/unit/run.mjs api",
    "unit:web": "node scripts/unit/run.mjs web",
    "unit:contracts": "node scripts/unit/run.mjs contracts",
    "unit:prototype": "node scripts/unit/run.mjs prototype",
    "unit:coverage": "node scripts/unit/run.mjs",
    "test:unit-infrastructure": "node --test --test-timeout=60000 scripts/unit/infrastructure.test.mjs scripts/unit/upload.test.mjs",
    "unit:artifacts": "node scripts/unit/artifacts.mjs",
    "test:web:integration": "pnpm --filter @rielia/contracts build && node --test scripts/identity-proxy.integration.test.mjs scripts/identity-client.integration.test.mjs scripts/workspace-client.test.mjs scripts/task-events-proxy.integration.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@rielia/contracts": "workspace:*",
    "bun-types": "1.4.4",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.10",
    "husky": "9.1.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lint-staged": "17.6.0"
  }
}
