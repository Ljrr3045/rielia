# Optional host development overrides. Defaults work without any environment file.
# Put only HOST/PORT in apps/api/.env and only API_BASE_URL in
# apps/web/.env.local. Do not copy the API port override to the web.
# These URLs/ports are local development values, not deployment settings.
HOST=127.0.0.1
PORT=3001
API_BASE_URL=http://127.0.0.1:3001
# The default fixture needs no credentials. Optional identity setup uses
# apps/api/.env.example and docs/development/identity-spike.md.

# LOCAL Docker preparation only; copy this section to a root .env.
# See docs/development/local-runtime.md. Compose sets its own internal HOST/PORT.
# Generate an untracked password with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use hex (URL-safe); never use production credentials with this local fixture.
LOCAL_POSTGRES_PASSWORD=
LOCAL_WEB_PORT=3000
LOCAL_API_PORT=3001
