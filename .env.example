# Optional local overrides. Defaults work without any environment file.
# Put only HOST/PORT in apps/api/.env and only API_BASE_URL in
# apps/web/.env.local. Do not copy the API port override to the web.
# These URLs/ports are local development values, not deployment settings.
HOST=127.0.0.1
PORT=3001
API_BASE_URL=http://127.0.0.1:3001
# No OAuth, database, or other credentials are used by the fixture.
