# Copy to .env in this directory; keep actual values private and untracked.
HOST=127.0.0.1
PORT=3001
IDENTITY_ENABLED=false
# Opt-in container diagnostics only; ordinary liveness/identity do not require it.
LOCAL_RUNTIME_ENABLED=false
# Required only when identity is enabled. Canonical origin, without a path.
BETTER_AUTH_URL=https://app.example.com
BETTER_AUTH_SECRET=
DATABASE_URL=
# Each provider is optional; a configured provider needs BOTH values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Explicit proxy IPs/CIDRs only; empty means no proxy trust.
IDENTITY_TRUSTED_PROXIES=
# Only for non-production HTTP on localhost/127.0.0.1/[::1].
IDENTITY_ALLOW_HTTP_LOOPBACK=false
