generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  principal Principal?
  @@map("user")
}

// T35.0 keeps the small domain substrate backend-local. SQL migration supplies
// checks, immutable identity guards and deferred cross-row policy constraints.
model Principal {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  kind String
  state String @default("active")
  displayName String
  userId String? @unique
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspaceId String?
  workspace Workspace? @relation("AgentWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  custodianPrincipalId String?
  custodian Principal? @relation("Custodian", fields: [custodianPrincipalId], references: [id], onDelete: Restrict)
  managedAgents Principal[] @relation("Custodian")
  memberships Membership[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  subjectGrants ExecutionGrant[] @relation("GrantSubject")
  authorizedGrants ExecutionGrant[] @relation("GrantAuthorizer")
  invitations Invitation[] @relation("InvitationIssuer")
  workspaceOperations WorkspaceOperation[]
  createdAt DateTime @default(now())
  @@index([workspaceId])
  @@index([custodianPrincipalId])
  @@map("principal")
}

model Workspace {
  id String @id
  name String
  ownerPrincipalId String
  owner Principal @relation("WorkspaceOwner", fields: [ownerPrincipalId], references: [id], onDelete: Restrict)
  agents Principal[] @relation("AgentWorkspace")
  memberships Membership[]
  grants ExecutionGrant[]
  invitations Invitation[]
  createdAt DateTime @default(now())
  @@map("workspace")
}

model Membership {
  workspaceId String
  principalId String
  role String
  state String @default("active")
  version Int @default(1)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  principal Principal @relation(fields: [principalId], references: [id], onDelete: Restrict)
  issuedInvitations Invitation[]
  projectAccesses ProjectAccess[]
  @@id([workspaceId, principalId])
  @@index([principalId])
  @@map("membership")
}

model Invitation {
  id String @id
  workspaceId String
  issuerPrincipalId String
  recipientEmail String
  role String
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  issuer Principal @relation("InvitationIssuer", fields: [issuerPrincipalId], references: [id], onDelete: Restrict)
  issuerMembership Membership @relation(fields: [workspaceId, issuerPrincipalId], references: [workspaceId, principalId], onDelete: Restrict)
  @@index([workspaceId, createdAt])
  @@map("invitation")
}

// Successful request receipts contain no raw invitation/session/credential token.
model WorkspaceOperation {
  actorPrincipalId String
  key String
  requestHash String
  response Json
  createdAt DateTime @default(now())
  actor Principal @relation(fields: [actorPrincipalId], references: [id], onDelete: Restrict)
  @@id([actorPrincipalId, key])
  @@map("workspace_operation")
}

// Policy records only: no token, OAuth consent, client authentication or secret.
model ExecutionGrant {
  id String @id
  workspaceId String
  subjectPrincipalId String
  authorizedByPrincipalId String
  mode String
  allowedOperations String[]
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subject Principal @relation("GrantSubject", fields: [subjectPrincipalId], references: [id], onDelete: Restrict)
  authorizer Principal @relation("GrantAuthorizer", fields: [authorizedByPrincipalId], references: [id], onDelete: Restrict)
  @@index([workspaceId, subjectPrincipalId])
  @@map("execution_grant")
}

model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("session")
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}

// T06 owns these backend-local tables; SQL supplies composite scope FKs,
// immutable history, versions and allocation guards. No runtime schema writes.
model Project {
  id String @id
  sequence Int @unique @default(autoincrement())
  workspaceId String
  key String
  name String
  description String @default("")
  visibility String @default("workspace")
  nextTaskNumber Int @default(1)
  taskRevision Int @default(1)
  version Int @default(1)
  archivedAt DateTime?
  createdByPrincipalId String
  creationMode String
  creationSource String
  creationGrantId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  accesses ProjectAccess[]
  @@unique([workspaceId, key])
  @@unique([workspaceId, id])
  @@unique([workspaceId, sequence])
  @@map("project")
}

// T07 access is independent of (and never restores) workspace membership.
model ProjectAccess {
  workspaceId String
  projectId String
  principalId String
  state String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  project Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  membership Membership @relation(fields: [workspaceId, principalId], references: [workspaceId, principalId], onDelete: Restrict)
  @@id([workspaceId, projectId, principalId])
  @@index([workspaceId, principalId, state, projectId])
  @@map("project_access")
}

model Task {
  id String @id
  workspaceId String
  projectId String
  number Int
  title String
  description String @default("")
  type String @default("task")
  priority String @default("none")
  status String @default("backlog")
  rank BigInt @default(0)
  assigneePrincipalId String?
  dueDate DateTime? @db.Date
  version Int @default(1)
  archivedAt DateTime?
  createdByPrincipalId String
  creationMode String
  creationSource String
  creationGrantId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  @@unique([workspaceId, projectId, number])
  @@unique([workspaceId, projectId, id])
  @@unique([workspaceId, projectId, status, rank], map: "task_scope_status_rank")
  @@map("task")
}

model ActivityEvent {
  id String @id
  workspaceId String
  projectId String
  taskId String?
  actorPrincipalId String
  executionMode String
  source String
  grantId String?
  requestId String
  action String
  entityVersion Int
  changedFields String[]
  accessPrincipalId String?
  createdAt DateTime @default(now())
  @@unique([workspaceId, id])
  @@map("activity_event")
}

model OutboxEvent {
  id String @id
  workspaceId String
  activityId String @unique
  type String
  payload Json
  createdAt DateTime @default(now())
  @@map("outbox_event")
}

model ProjectTaskOperation {
  workspaceId String
  actorPrincipalId String
  executionScope String
  key String
  requestHash String
  response Json
  createdAt DateTime @default(now())
  @@id([workspaceId, actorPrincipalId, executionScope, key])
  @@map("project_task_operation")
}
